# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Go files always use LF
*.go text eol=lf
go.mod text eol=lf
go.sum text eol=lf

# Shell scripts use LF
*.sh text eol=lf

# YAML/JSON/Markdown use LF
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf

# Dockerfiles use LF
Dockerfile* text eol=lf
dockerfiles/* text eol=lf

# Binary files
*.exe binary
*.tar binary
*.png binary
*.jpg binary
*.ico binary
*.wasm binary